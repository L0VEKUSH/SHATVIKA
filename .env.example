# SHATVIKA CORNER environment contract
# Copy this file to .env.local for local development. Never commit .env.local.
# NEXT_PUBLIC_* values are included in browser bundles; never place secrets in them.

# ==== Application identity and canonical URLs ====
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME=SHATVIKA CORNER
BUSINESS_TIME_ZONE=Asia/Kolkata
# Client display only; keep aligned with BUSINESS_TIME_ZONE.
NEXT_PUBLIC_BUSINESS_TIME_ZONE=Asia/Kolkata

# ==== Database ====
# Checkout transactions require a transaction-capable MongoDB deployment. For local
# development, use a replica set rather than a standalone mongod process.
MONGODB_URI=
MONGODB_DB=SHATVIKA

# ==== Signed sessions and CSRF ====
# Generate independent high-entropy values (at least 32 random bytes) for production.
ADMIN_JWT_SECRET=
CUSTOMER_JWT_SECRET=
# Independent high-entropy signing secret used only for worker sessions.
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
WORKER_JWT_SECRET=
CSRF_SECRET=

# ==== Optional Google customer sign-in ====
# Guest checkout remains available when these are blank. Configure this exact
# redirect URI in the Google Cloud OAuth web client for local development.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# ==== One-time admin bootstrap ====
# Keep disabled after the first authorized administrator is created. Enabling the
# route also requires a separate high-entropy setup key.
ADMIN_BOOTSTRAP_ENABLED=false
ADMIN_SETUP_KEY=

# ==== One-time guarded legacy-admin compatibility repair ====
# Set these only for `npm run admin:repair`, then remove them. Never commit values.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_REPAIR_CONFIRM=

# ==== Counter collection and owner/accountant-confirmed checkout rules ====
# Delivery is intentionally disabled for new orders. Missing fulfillmentType on
# historical orders continues to mean legacy delivery in reporting.
DELIVERY_ENABLED=false
COUNTER_LOCATION_ID=shatvika-corner
COUNTER_LOCATION_NAME=Shatvika Corner
COUNTER_TOKEN_PREFIX=SC
# Money values are integer paise. Tax uses basis points (500 = 5.00%). These values
# intentionally have no guessed defaults; checkout stays unavailable until supplied.
TAX_RATE_BASIS_POINTS=
# Optional bounded operational defaults.
MAX_QUANTITY_PER_ITEM=10
TARGET_PREPARATION_MINUTES=20
MAX_OUTSTANDING_GUEST_ORDERS=5

# ==== Password-reset email (optional; disabled unless complete) ====
RESEND_API_KEY=
PASSWORD_RESET_FROM_EMAIL=

# ==== Durable media storage (optional; disabled unless complete) ====
# Supported value: cloudinary. Do not configure local public/uploads storage.
MEDIA_STORAGE_PROVIDER=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Provider request timeout, bounded to 5000-60000 milliseconds.
MEDIA_STORAGE_TIMEOUT_MS=30000

# ==== Reverse-proxy client-IP trust ====
# Leave both defaults unchanged unless the deployment topology is known and verified.
TRUST_CF_CONNECTING_IP=false
TRUSTED_PROXY_HOPS=0

# ==== Owner-supplied public business information (optional) ====
NEXT_PUBLIC_BUSINESS_ADDRESS=
NEXT_PUBLIC_BUSINESS_PHONE=
NEXT_PUBLIC_BUSINESS_EMAIL=
NEXT_PUBLIC_BUSINESS_HOURS=
NEXT_PUBLIC_INSTAGRAM_URL=

# ==== Owner/legal-adviser supplied policy text (optional) ====
# The policy page labels omitted content as awaiting confirmation.
BUSINESS_DELIVERY_POLICY=
BUSINESS_CANCELLATION_REFUND_POLICY=
BUSINESS_PRIVACY_NOTICE=
BUSINESS_TAX_INFORMATION=

# ==== Guard for applying the evidence-only legacy backfill ====
# Dry-run is the default. Applying also requires a non-production database name
# containing test/dev/local/staging and this exact confirmation value.
MIGRATION_CONFIRM=SHATVIKA_LEGACY_BACKFILL

# ==== Local/controlled worker provisioning only ====
# Never expose worker creation as a public route. Set these only for the one command:
# npm run worker:create
WORKER_PROVISION_CONFIRM=
WORKER_NAME=
WORKER_EMAIL=
WORKER_PASSWORD=
WORKER_LOCATION_ID=

# Online payments are intentionally not configured by an environment label alone.
# Until a real provider integration is installed and verified, payment is verified at the counter.
